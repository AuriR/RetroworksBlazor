@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="retro-container" id="retro-container">
    <RetroScreen App="@_app" Tick="@_tick" />
</div>

@code {
    private Core.App _app = new();
    private int _tick;
    private DotNetObjectReference<RetroApp>? _appRef;
    private IJSObjectReference? _jsModule;
    private bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started) return;
        _started = true;

        // Import the JS module FIRST, then wire everything up.
        _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");

        // Subscribe to render requests from the App; also sync the CSS theme.
        _app.RenderRequested += () => InvokeAsync(() =>
        {
            _tick = _app.RenderTick;
            SyncTheme();
            StateHasChanged();
        });

        // Set up JS interop functions on the App (download / file picker).
        _app.DownloadFileFunc = async (fileName, content) =>
            await _jsModule.InvokeVoidAsync("downloadFile", fileName, content);
        _app.PrintPdfFunc = async (fileName, pages) =>
            await _jsModule.InvokeVoidAsync("printPdf", fileName, pages);
        _app.LoadFileFunc = async accept =>
            await _jsModule.InvokeAsync<string>("loadFile", accept);

        // localStorage persistence ("the disk" that survives refresh/restart).
        // v1.7: every call is scoped to a Desktop id (multiple named Desktops).
        _app.SaveLocalFileFunc = async (desktopId, name, json) =>
            await _jsModule.InvokeAsync<bool>("saveLocalFile", desktopId, name, json);
        _app.LoadLocalFileFunc = async (desktopId, name) =>
            await _jsModule.InvokeAsync<string?>("loadLocalFile", desktopId, name);
        _app.ListLocalFilesFunc = async desktopId =>
            await _jsModule.InvokeAsync<List<string>>("listLocalFiles", desktopId);
        _app.DeleteLocalFileFunc = async (desktopId, name) =>
            await _jsModule.InvokeAsync<bool>("deleteLocalFile", desktopId, name);

        // Desktop management (v1.7): named Desktops, each with its own file set.
        _app.ListDesktopsFunc = async () =>
        {
            var r = await _jsModule.InvokeAsync<Dictionary<string, object>>("listDesktops");
            var list = ((System.Text.Json.JsonElement)r["desktops"]).EnumerateArray()
                .Select(e => (e.GetProperty("id").GetString()!, e.GetProperty("name").GetString()!))
                .ToList();
            return (list, ((System.Text.Json.JsonElement)r["currentId"]).GetString() ?? "d1");
        };
        _app.CreateDesktopFunc = async name =>
            await _jsModule.InvokeAsync<string?>("createDesktop", name);
        _app.RenameDesktopFunc = async (id, name) =>
            await _jsModule.InvokeAsync<bool>("renameDesktop", id, name);
        _app.DeleteDesktopFunc = async id =>
            await _jsModule.InvokeAsync<bool>("deleteDesktop", id);
        _app.SetCurrentDesktopFunc = async id =>
            await _jsModule.InvokeAsync<string?>("setCurrentDesktop", id);

        // Custom spell-check dictionary (global, not per-Desktop).
        _app.SaveCustomDictFunc = async json =>
            await _jsModule.InvokeAsync<bool>("saveCustomDict", json);
        _app.LoadCustomDictFunc = async () =>
            await _jsModule.InvokeAsync<string?>("loadCustomDict");

        // Settings persistence (v1.7).
        _app.LoadSettingsFunc = async () =>
        {
            var r = await _jsModule.InvokeAsync<Dictionary<string, object>>("loadSettings");
            int memKb = Convert.ToInt32(((System.Text.Json.JsonElement)r["memKb"]).GetDouble());
            string theme = ((System.Text.Json.JsonElement)r["theme"]).GetString() ?? "green";
            bool crt = ((System.Text.Json.JsonElement)r["crt"]).GetBoolean();
            string lang = ((System.Text.Json.JsonElement)r["lang"]).GetString() ?? "en";
            return (memKb, theme, crt, lang);
        };
        _app.SaveSettingsFunc = async (memKb, theme, crt, lang) =>
            await _jsModule.InvokeAsync<bool>("saveSettings", memKb, theme, crt, lang);

        // Register the global keydown handler that calls back into THIS component
        // (the [JSInvokable] OnKey method lives here, not on Core.App).
        _appRef = DotNetObjectReference.Create(this);
        await _jsModule.InvokeVoidAsync("initKeyHandler", _appRef);

        SyncTheme();

        // Start the app main loop in the background.
        var jsModule = _jsModule;
        _ = Task.Run(async () =>
        {
            try { await _app.RunAsync(); }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"App error: {ex}");
                // Surface the exception in the browser so it is not silently swallowed.
                try { if (jsModule is not null) await jsModule.InvokeVoidAsync("reportError", ex.ToString()); }
                catch { /* interop itself failed; nothing more we can do */ }
            }
        });

        StateHasChanged();
    }

    /// <summary>Apply the App's theme ("green"/"amber") and CRT emulation to the document root.</summary>
    private void SyncTheme()
    {
        if (_jsModule is not null)
            _ = _jsModule.InvokeVoidAsync("setTheme", _app.Theme, _app.CrtEmulation);
    }

    [JSInvokable]
    public void OnKey(string token)
    {
        InvokeAsync(() => _app.EnqueueKey(token));
    }

}
